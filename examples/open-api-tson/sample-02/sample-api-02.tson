@openapi("3.0.0")

info {
  id: my-api
  title: "My Application API ${titleSuffix}"
  version: "1.2.3"
  description: "This document is part of My Application Documentation. It describes WebServices API exposed by My Application to Consumer Systems."
  contact: {
    name: "My Support"
    email: "contact@mycompany.com"
    url: "https://www.mycompany.com"
    phone: "11 22 33 44"
  }
  x-logo: {
    url: ""
  }
  changes [
    {
      date: "2010-02-12"
      version: "1.1"
      title: "Added /login"
      observations: "The following are the changes since 1.0"
      details: [
        "ADDED REQUEST: added /login"
      ]
    }
    {
      date: "2009-08-07"
      version: "1.0.0"
      title: "Initial version"
      observations: "firstAPIs"
      details: []
    }
  ]
}

custom {
  variables: {}
  multi-document: {
    internal: {
      variables: {
        internal: true
        titleSuffix: "(Internal)"
      }
    }
    external: {}
  }
  config: {
    description: "This document is part of My Application Documentation. It describes WebServices API exposed by My Application to Consumer Systems."
    variables: {
      server-prod-url: {
        name: "Production Server URL"
        description: "This URL points to the production server available for ##your company##"
        example: "https://your-company.myapp.tn/api"
      }
      server-preprod-url: {
        name: "Pre-Production Server URL"
        description: "This URL points to the pre-production server available for ##your company##"
        example: "https://preprod.your-company.myapp.tn/api"
      }
      server-staging-url: {
        name: "API staging Server URL"
        description: "This URL points to the staging server for testing API available for ##your company##"
        example: "https://staging.your-company.myapp.tn/api"
      }
      company-api-key: {
        name: "API Key"
        description: "API Key is the private identification key for ##your company##"
        example: "12345678-bcc8-4a9b-b500-9c96a17126d7"
      }
    }
  }
}

servers [
  url("<<server-prod-url>> located in your configuration document" description: "This is the main My Application api server URL. An example is https://your-company.myapp.tn/api")
  url("<<server-preprod-url>> located in your configuration document" description: "This is an pre-production server used for testing new deployments. An example is https://preprod.your-company.myapp.tn/api")
  url("<<server-staging-url>> located in your configuration document" description: "This is an internal (staging) server used for testing new API deployments. An example is https://staging.your-company.myapp.tn/api")
]

paths {

  @enabled("${!internal}")
  @summary("Returns the deployed API version")
  GET("/version") {
    out(200): VersionResponse(json description: "Returns the deployed API version information" example: { version: "1.2" })
  }

  @summary("Log into the system and obtain an access authorization token. This Method is used by Mobile Application to log the user in")
  POST("/login") {
    @required in: LoginModel(json description: "Login information" example: { username: "customer" password: "1234" })
    out(200): LoginResponse(json description: "Returns a well formed token information" example: { accessToken: "5odHRwLlJlc3BvbnNlR...ICA5Iik7DQogIGFsdGhW50aXR=" })
    out(400): ErrorType(json description: "Returns object not found if the user or the token does not match" example: { success: false error: "USER_NOT_FOUND" details: "invalid login or password" api-version: "1.0" })
    out(403): ErrorType(json description: "Returns forbidden access if the access could not be granted" example: { success: false error: "ACCESS_NOT_ALLOWED" details: "Access Not Allowed" api-version: "1.0" })
  }
}

components {
  securitySchemes {
    JWTAuth: http(bearer bearerFormat: JWT description: "Example: 
> Authorization: Bearer <token>")
    api_key: apiKey(header: X-API-KEY description: "This api key is mandatory and must be a valid MYAPP API-KEY. All API calls must include this key in the request Header. Your company's api key is defined in your custom configuration document as ##<<company.api-key>>##")
  }
  headers {
    @required(false) X-MYAPP-API-VERSION: string(description: "The request API version. If not specified, latest version will be considered. The Server can reject a request with an invalid api version")
    @required(false) X-MYAPP-AGENT: string(description: "The user agent used to connect to the API. This is mainly used by Mobile Application in the Login call. The Server can reject a request with an invalid user agent or version")
  }
  schemas {
    LoginModel(format: intermediate-structure description: "LoginModel details the information used for Login method input" example: { username: "customer" password: "1234" }) {
      @required username: string(description: "User name" example: "customer")
      @required password: string(description: "User password" example: "1234")
    }
    LoginResponse(format: intermediate-structure description: "LoginResponse details information used as Login method result" example: { accessToken: "ICAgIGFsdGh...5odHRwLlJlc3BvbnNlRW50aXR5Iik7DQo=" }) {
      @required accessToken: string(minLength: 0 maxLength: 512 description: "Authorization Token" example: "ICAgIGFsdGh...5odHRwLlJlc3BvbnNlRW50aXR5Iik7DQo=")
    }
    VersionResponse(description: "VersionResponse details all API version information" example: { version: "1.2.3" }) {
      @required version: string(description: "version string" example: "1.2.3")
    }
    ErrorType(description: "Message format when any error occurs" example: { success: false error: "DOCUMENT_NOT_FOUND" details: "document should not be missing" api-version: "1.0" }) {
      @required success: boolean(description: "The value must be 'false'" enum: [false] example: false)
      @required error: string(description: "An error code" example: "DOCUMENT_NOT_FOUND")
      details: string(description: "A user friendly error message. Can be null or non present" example: "document should not be missing")
      api-version: string(description: "Server side api-version" example: "1.0")
    }
  }
}

security [
  JWTAuth
]
